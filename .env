# Copy to .env before `docker compose up`.

DATABASE_URL=postgresql+psycopg://sentinel:sentinel@db:5432/sentinelface
REDIS_URL=redis://redis:6379/0

CONFIG_DIR=/config
STORAGE_DIR=/storage
MODEL_ROOT=/storage/models

# InsightFace execution context: -1 = CPU, 0 = first GPU.
# No CUDA on Apple Silicon, so -1 here.
CTX_ID=-1

CORS_ORIGINS=http://localhost:5173

# Public base used to build crop_url values returned by the API.
PUBLIC_BASE_URL=http://localhost:8000
